{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/dataset.js": { "includeFiles": "data/**" }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/dataset?route=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
