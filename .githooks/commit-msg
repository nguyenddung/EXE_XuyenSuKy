#!/bin/sh
# Strip AI attribution from commit messages: Claude/Anthropic co-author trailers,
# "Generated with Claude Code" footers and Claude session links.
# Enable once per clone: git config core.hooksPath .githooks

msg_file="$1"
tmp_file="$msg_file.clean"

grep -v -i -E \
  -e '^[[:space:]]*co-authored-by:.*(claude|anthropic)' \
  -e 'generated (with|by) .*claude' \
  -e 'claude\.(ai|com)/code' \
  "$msg_file" > "$tmp_file"

# Drop trailing blank lines left behind by removed footers.
sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp_file" > "$msg_file"
rm -f "$tmp_file"

if ! grep -q -v -E '^[[:space:]]*(#|$)' "$msg_file"; then
  echo "commit-msg: commit message is empty after removing AI attribution." >&2
  exit 1
fi
