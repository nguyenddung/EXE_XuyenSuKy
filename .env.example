# Optional. Without this, backend reads the bundled data/history snapshot.
# Point to the folder containing manifest.json, lessons/, chunks/ and schema/.
# DATASET_PATH=D:/FALL2026/EXE/dataset/dataset
# Standalone backend defaults to loopback port 3001.
# HOST=127.0.0.1
# PORT=3001

# Server only: never prefix this with VITE_ or commit a real key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# Kill switch: answer with textbook quotes only, without removing the key.
# AI_DISABLED=1

# Chat spam protection and AI budget (defaults shown).
# Over CHAT_RATE_PER_MINUTE a visitor gets HTTP 429; over the AI limits chat answers with textbook quotes.
# CHAT_RATE_PER_MINUTE=12
# AI_ANSWERS_PER_DAY=40
# AI_GLOBAL_ANSWERS_PER_DAY=500
# Optional: share the counters across all Vercel instances (Upstash Redis REST). Without it they are per instance.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Character speech: ElevenLabs or Azure, server only. Never use VITE_ for a secret.
# Add the actual secret API key, not its public key ID.
# SPEECH_PROVIDER=elevenlabs
# Optional kill switch for server speech: use browser speech without paid requests.
# SPEECH_DISABLED=1
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Default male/female voices; optional per-character overrides shown for the animated pair.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_FEMALE_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_TRAN_HUNG_DAO=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_NGO_QUYEN=onwK4e9ZLuTAKqWW03F9
# Narrator of journey videos, used only by `npm run build:narration` (pre-recorded MP3s).
# The Free plan can call premade voices only, not Voice Library voices (HTTP 402).
# ELEVENLABS_NARRATOR_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Use SPEECH_PROVIDER=azure to select Azure explicitly.
# Never use VITE_ for these. Without them, the UI tries an installed Vietnamese browser voice.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=southeastasia
# Limits apply to audio generation, independently of chat/AI limits.
# SPEECH_RATE_PER_MINUTE=12
# SPEECH_REQUESTS_PER_DAY=40
# SPEECH_GLOBAL_REQUESTS_PER_DAY=500
