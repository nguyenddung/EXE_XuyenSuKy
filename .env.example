# Optional. Without this, backend reads the bundled data/history snapshot.
# Point to the folder containing manifest.json, lessons/, chunks/ and schema/.
# DATASET_PATH=D:/FALL2026/EXE/dataset/dataset
# Standalone backend defaults to loopback port 3001.
# HOST=127.0.0.1
# PORT=3001

# Server only: never prefix this with VITE_ or commit a real key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# Kill switch: answer with textbook quotes only, without removing the key.
# AI_DISABLED=1

# Chat spam protection and AI budget (defaults shown).
# Over CHAT_RATE_PER_MINUTE a visitor gets HTTP 429; over the AI limits chat answers with textbook quotes.
# CHAT_RATE_PER_MINUTE=12
# AI_ANSWERS_PER_DAY=40
# AI_GLOBAL_ANSWERS_PER_DAY=500
# Optional: share the counters across all Vercel instances (Upstash Redis REST). Without it they are per instance.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
