{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xuyen-su-ky/enrichment/alias",
  "title": "Nhóm tên gọi tương đương dùng để mở rộng truy vấn tìm kiếm",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "terms"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "type": { "enum": ["person", "place", "dynasty", "organization", "event"] },
    "terms": {
      "description": "Phần tử đầu là cách viết chuẩn trong SGK; các phần tử sau là tên gọi khác, phiên âm gốc hoặc viết tắt.",
      "type": "array",
      "items": { "type": "string", "minLength": 2, "maxLength": 80 },
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true
    }
  }
}
