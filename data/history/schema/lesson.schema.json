{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XuyenSuKi lesson",
  "type": "object",
  "required": [
    "grade",
    "subject",
    "book",
    "chapter",
    "lesson_number",
    "lesson_title",
    "page_start",
    "page_end",
    "source_pdf",
    "sections"
  ],
  "properties": {
    "grade": {
      "type": "integer",
      "minimum": 6,
      "maximum": 12
    },
    "subject": {
      "const": "history"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "lesson_number": {
      "type": "integer",
      "minimum": 0
    },
    "lesson_title": {
      "type": "string",
      "minLength": 1
    },
    "page_start": {
      "type": "integer",
      "minimum": 1
    },
    "page_end": {
      "type": "integer",
      "minimum": 1
    },
    "source_pdf": {
      "type": "string"
    },
    "title_source": {
      "enum": [
        "toc",
        "toc_by_number",
        "page"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          },
          "page_marks": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          }
        }
      }
    }
  }
}